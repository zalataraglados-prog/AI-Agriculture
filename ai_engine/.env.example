# Service AI Engine - Environment Variables Example
# Copy this file to .env and adjust the values for your local or production environment.

# CORS Configuration
# CORS_ORIGINS=http://localhost:8088,http://127.0.0.1:8088
# CORS_ALLOW_CREDENTIALS=false
# CORS_ALLOW_METHODS=GET,POST,OPTIONS
# CORS_ALLOW_HEADERS=Authorization,Content-Type

# Model Execution Overrides
# MODEL_CHECKPOINT_PATH=models/rice/rice_leaf_classifier/best_model.pth
# MODEL_LABELS_FILE=models/rice/rice_leaf_classifier/labels.json
# MODEL_CONFIG_FILE=models/rice/rice_leaf_classifier/config.yaml
# MODEL_ADVICE_FILE=models/rice/rice_leaf_classifier/advice_map.yaml

# Oil Palm Model Mode: mock | real | hybrid
# - mock:   All tasks use mock predictors. Default. Safe for demo/CI.
# - real:   All tasks must load real weights. Fail fast if missing.
# - hybrid: Real if weights exist, mock fallback otherwise.
# OIL_PALM_MODEL_MODE=mock

# Oil Palm Model Paths (only needed for real/hybrid mode)
# OIL_PALM_FFB_MODEL_PATH=models/oil_palm/ffb_maturity/best.pt
# OIL_PALM_UAV_CROWN_MODEL_PATH=models/oil_palm/uav_tree_crown/best.pt
# OIL_PALM_GANODERMA_MODEL_PATH=models/oil_palm/ganoderma_risk/best.pt
# OIL_PALM_A0_MODEL_PATH=models/oil_palm/a0_image_routing/best.pt
# OIL_PALM_CONFIDENCE_THRESHOLD=0.5
